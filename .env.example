# Server Configuration
PORT=3000
# In produzione imposta DATA_DIR sul percorso del disco persistente del provider.
# Esempio Render: /var/data
# DATA_DIR=/var/data
# Per usare PostgreSQL (es. Supabase), imposta DATABASE_URL nelle variabili Render.
# DATABASE_URL=postgresql://...

# Discord OAuth2 Credentials
DISCORD_CLIENT_ID=YOUR_DISCORD_CLIENT_ID
DISCORD_CLIENT_SECRET=YOUR_DISCORD_CLIENT_SECRET
DISCORD_REDIRECT_URI=https://discordheadstaff.onrender.com/api/auth/discord/callback

# Session Security
SESSION_SECRET=admin_ids_pro_secret_key_2026
